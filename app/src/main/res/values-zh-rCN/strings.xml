<resources>
    <string name="app_name">OpenTouchpad</string>
    <string name="app_description">给无法够到整块屏幕的人：触控板、屏幕光标和大按钮。离线、无广告、无统计。</string>
    <string name="service_label">OpenTouchpad 触控板</string>
    <string name="service_description">在屏幕一角显示触控板、光标和大按钮，用很小的动作操作整块屏幕。不联网、无广告、无统计。</string>

