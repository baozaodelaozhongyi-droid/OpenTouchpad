<resources>
    <string name="app_name">OpenTouchpad</string>
    <string name="app_description">专为单手操作与触控受限场景设计的辅助工具：提供屏幕触控板、指针光标与便捷功能按键。离线运行，无广告，无数据统计。</string>
    <string name="service_label">OpenTouchpad 触控板</string>
    <string name="service_description">通过屏幕悬浮触控板与指针光标，以微小操作幅度精准控制整个屏幕。无网络请求、无广告，完全离线运行。</string>

    <!-- 状态 / 引导 -->
