<resources>
    <string name="app_name">OpenTouchpad</string>
    <string name="app_description">Accessibility tool designed for one-handed operation and reachability: on-screen touchpad, precision cursor, and customizable shortcut buttons. Offline, ad-free, and no tracking.</string>
    <string name="service_label">OpenTouchpad Accessibility Service</string>
    <string name="service_description">Provides an on-screen touchpad and cursor overlay to control the entire display with minimal finger movements. Fully offline with zero network requests.</string>

    <!-- 状态 / 引导 -->
    <string name="status_on">Accessibility service is running</string>
