    <string name="pad_height_hint">Panel width sets the button scale. At 0 extra height, buttons form a compact equidistant grid; extra height expands the touchpad surface vertically while keeping button size constant.</string>
    <string name="set_cursor_hold">Cursor Long-Press Duration</string>
    <string name="cursor_hold_hint">Hold duration for the "Long Press" action on the screen; also used as anchor hold time before dragging in Drag Lock.</string>
    <string name="drag_lock_hint">Drag Lock guide: Tap the button to lock the starting point and show an anchor halo at the cursor; slide to the destination and tap again to perform drag. Tap without moving to cancel.</string>
    <string name="switch_show_panel">Show Touchpad Panel</string>
    <string name="switch_show_panel_hint">When disabled, minimizes the panel into a floating ball; tap the floating ball to expand at any time.</string>
