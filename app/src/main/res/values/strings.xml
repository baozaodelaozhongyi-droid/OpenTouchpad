<resources>
    <string name="app_name">OpenTouchpad</string>
    <string name="app_description">Touchpad, cursor and large buttons for people who cannot reach the whole screen. Offline, no ads, no analytics.</string>
    <string name="service_label">OpenTouchpad touchpad</string>
    <string name="service_description">Shows a touchpad, an on-screen cursor and large buttons so you can control the whole screen with small movements. No internet, no ads, no tracking.</string>

    <!-- 状态 / 引导 -->
    <string name="status_on">✅ Service is running</string>
